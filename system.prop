# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# HWUI
debug.hwui.skia_atrace_enabled=false

# FM Radio configuration
ro.fm.chip=0x6635
ro.fm.band=3
ro.fm.low_band=875
ro.fm.high_band=1080
ro.fm.seek_space=10

# OTA Updater
lineage.updater.uri=https://ota.a14185638.top/api/v2/devices/{device}/builds
